{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vectra-manifest",
  "title": "Vectra AI manifest",
  "description": "dist/ai/vectra.manifest.json, generated by build/manifest.mjs from site/data/components, build/token-contract.json, src/icons/icons.json, src/js and src/css. Everything an AI assistant needs to write valid Vectra markup. Keys appear in the order listed here. Only the JSON Schema subset used by build/site-data.mjs is used: type, required, properties, additionalProperties, enum, pattern, items, minItems.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "package", "version", "summary", "homepage", "repository", "license", "install", "files", "theme", "rules", "tokens", "layout", "utilities", "components", "hooks", "api", "icons", "patterns"],
  "properties": {
    "$schema": { "type": "string", "description": "Relative path to this schema." },
    "name": { "type": "string" },
    "package": { "type": "string", "description": "The npm package name." },
    "version": { "type": "string", "description": "The package version the manifest was built from." },
    "summary": { "type": "string" },
    "homepage": { "type": "string", "description": "The docs site, ending in a slash." },
    "repository": { "type": "string" },
    "license": { "type": "string" },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npm", "head", "production", "page", "notes"],
      "properties": {
        "npm": { "type": "string", "description": "The install command." },
        "head": { "type": "string", "description": "The two tags that load everything: the full CSS bundle and the JS." },
        "production": { "type": "string", "description": "The smaller set: core CSS, the components CSS and one direction." },
        "page": { "type": "string", "description": "A complete, valid page skeleton to start from." },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "files": {
      "type": "array",
      "description": "Built files, relative to the package root.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "description"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "enum": ["css", "js", "fonts", "icons", "ai"] },
          "description": { "type": "string" }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributes", "directions"],
      "properties": {
        "attributes": {
          "type": "array",
          "description": "Attributes and properties on <html> that switch the look. Vectra.theme.set() writes them.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "on", "values", "default", "description"],
            "properties": {
              "name": { "type": "string" },
              "on": { "type": "string" },
              "values": { "type": "array", "items": { "type": "string" } },
              "default": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "directions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "label", "file", "description"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z]+$" },
              "label": { "type": "string" },
              "file": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "description": "Rules every page built with Vectra follows. The text is quoted verbatim in llms-full.txt and the Claude Code skill.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "rule"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "topic": { "enum": ["setup", "naming", "states", "javascript", "accessibility", "forms", "icons", "theming"] },
          "rule": { "type": "string" }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "contract", "component"],
      "properties": {
        "note": { "type": "string" },
        "contract": {
          "type": "array",
          "description": "The token contract from build/token-contract.json: required tokens every direction defines, then optional ones with defaults.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "level", "purpose", "overridable"],
            "properties": {
              "name": { "type": "string", "pattern": "^--v-[a-z0-9-]+$" },
              "level": { "enum": ["required", "optional"] },
              "purpose": { "type": "string" },
              "overridable": { "type": "boolean", "description": "True when a site may set it on :root or on a scope." }
            }
          }
        },
        "component": {
          "type": "array",
          "description": "Other custom properties components read, with the components that read them.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "components"],
            "properties": {
              "name": { "type": "string", "pattern": "^--v-[a-z0-9-]+$" },
              "components": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "layout": {
      "type": "array",
      "description": "Layout primitives from src/css/layout.css.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^v-[a-z0-9-]+$" },
          "description": { "type": "string" }
        }
      }
    },
    "utilities": {
      "type": "array",
      "description": "Utility classes from src/css/utilities.css, by group.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "classes"],
        "properties": {
          "group": { "type": "string" },
          "classes": { "type": "array", "items": { "type": "string", "pattern": "^v-[a-z0-9-]+$" } }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "slug", "group", "tier", "status", "summary", "native", "docs", "classes", "states", "hooks", "events", "keyboard", "a11y", "tokens", "related", "example"],
        "properties": {
          "name": { "type": "string" },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "group": { "type": "string" },
          "tier": { "enum": ["P0", "P1", "P2"] },
          "status": { "enum": ["done", "partial", "planned"] },
          "summary": { "type": "string" },
          "native": { "type": "string", "description": "The native element or attribute it builds on, empty when none." },
          "docs": { "type": "string", "description": "The component page on the docs site." },
          "classes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "description"],
              "properties": {
                "name": { "type": "string", "pattern": "^v-[a-z0-9-]+$" },
                "kind": { "enum": ["base", "modifier", "part", "helper"] },
                "description": { "type": "string" }
              }
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attribute", "description"],
              "properties": { "attribute": { "type": "string" }, "description": { "type": "string" } }
            }
          },
          "hooks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value", "on", "description"],
              "properties": {
                "name": { "type": "string", "pattern": "^data-v-[a-z0-9-]+$" },
                "value": { "type": "string" },
                "on": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "on", "detail", "cancelable", "description"],
              "properties": {
                "name": { "type": "string", "pattern": "^v:[a-z-]+$" },
                "on": { "type": "string" },
                "detail": { "type": "string" },
                "cancelable": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          },
          "keyboard": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["keys", "action"],
              "properties": { "keys": { "type": "array", "items": { "type": "string" } }, "action": { "type": "string" } }
            }
          },
          "a11y": { "type": "array", "items": { "type": "string" } },
          "tokens": { "type": "array", "items": { "type": "string", "pattern": "^--v-[a-z0-9-]+$" } },
          "related": { "type": "array", "items": { "type": "string" } },
          "example": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "html", "js"],
            "description": "The canonical example: the first example on the component page. Valid on its own in a page that loads dist/vectra.css and dist/vectra.js (checked by tests/manifest.spec.js).",
            "properties": {
              "title": { "type": "string" },
              "html": { "type": "string" },
              "js": { "type": "string", "description": "An ES module run after vectra.js, with window.Vectra available. Empty when the example needs no script." }
            }
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "description": "Every data-v-* hook: modules registered in src/js/index.js and the attributes they read.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "registered", "components"],
        "properties": {
          "name": { "type": "string", "pattern": "^data-v-[a-z0-9-]+$" },
          "registered": { "type": "boolean", "description": "True for a module that starts on its own (register() in src/js/index.js); false for an option attribute a module reads." },
          "components": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "api": {
      "type": "array",
      "description": "window.Vectra (the IIFE build) and the named exports of dist/vectra.esm.js.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "signature", "description"],
        "properties": {
          "name": { "type": "string", "description": "The export it belongs to." },
          "signature": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sprite", "usage", "names"],
      "properties": {
        "sprite": { "type": "string" },
        "usage": { "type": "string" },
        "names": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
      }
    },
    "patterns": {
      "type": "array",
      "description": "Example pages in examples/ to copy from: galleries and complete pages.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "description"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
