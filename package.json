{
  "name": "@creativeigniter/vectra",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Vectra v2: a zero-dependency UI kit built on the web platform.",
  "license": "MIT",
  "author": "Florin Pinta (https://github.com/xttrust)",
  "repository": "github:xttrust/vectra",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vectra-icons": "build/icons-subset.mjs"
  },
  "scripts": {
    "build": "node build/build.mjs && node build/icons.mjs",
    "build:icons": "node build/icons.mjs --sync",
    "build:fonts": "node build/fonts.mjs",
    "icons": "node build/icons-subset.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js",
    "check:size": "node build/check-size.mjs",
    "check:urls": "node build/check-urls.mjs",
    "check:baseline": "node build/check-baseline.mjs",
    "check:auth": "node build/auth-pages.mjs --check",
    "auth:pages": "node build/auth-pages.mjs",
    "check": "npm run lint && npm run check:tokens && npm run build && npm run check:size && npm run check:urls && npm run check:baseline && npm run check:auth",
    "serve": "node build/serve.mjs",
    "site": "node build/site.mjs",
    "site:check": "node build/site.mjs --check",
    "test": "playwright test --project=chromium --grep-invert @visual",
    "test:a11y": "playwright test --project=chromium tests/a11y.spec.js",
    "test:contrast": "playwright test --project=chromium tests/contrast.spec.js",
    "test:keyboard": "playwright test --project=chromium tests/keyboard.spec.js",
    "test:browsers": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --project=chromium --grep @visual",
    "test:visual:update": "playwright test --project=chromium --grep @visual --update-snapshots",
    "docker:test": "docker run --rm --ipc=host -u $(id -u):$(id -g) -e HOME=/tmp -e CI=1 -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test",
    "check:tokens": "node build/check-tokens.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@mdn/browser-compat-data": "8.1.7",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "inter-ui": "4.1.1",
    "lightningcss": "1.33.0",
    "lucide-static": "1.65.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "subset-font": "2.9.0"
  },
  "homepage": "https://xttrust.github.io/vectra/"
}
